{
  "name": "Category",
  "type": "object",
  "properties": {
    "name": { "type": "string" },
    "slug": { "type": "string" },
    "description": { "type": "string" },
    "image_url": { "type": "string" },
    "sort_order": { "type": "number", "default": 0 }
  },
  "required": ["name", "slug"]
}
